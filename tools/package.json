{
  "name": "plantuml-language-grammar-tools",
  "private": true,
  "type": "module",
  "description": "Renders and checks the PlantUML TextMate grammar the way GitHub highlights it",
  "scripts": {
    "grammar": "node generate-grammar.mjs",
    "build": "node generate-grammar.mjs && node render.mjs",
    "test": "node generate-grammar.mjs --check && node render.mjs --check",
    "site": "node site.mjs",
    "coverage": "node coverage.mjs"
  },
  "dependencies": {
    "js-yaml": "5.5.0",
    "shiki": "4.5.0"
  }
}
